# Flask Core Configuration
SECRET_KEY=generate_a_secure_random_key_here
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///careerpilot.db

# File Upload Settings
MAX_CONTENT_LENGTH=5242880  # 5 MB in bytes
UPLOAD_FOLDER=instance/uploads

# Optional AI Configuration (Supports 'gemini', 'openai', or leave blank for deterministic rule-based fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security & Session Settings
SESSION_COOKIE_SECURE=False  # Set to True in HTTPS production
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
